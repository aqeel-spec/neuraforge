{
  "name": "@neuraforge/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Public open-source NeuraForge UI monorepo",
  "license": "MIT",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "schemas:generate": "npm run generate --workspace @neuraforge/schemas",
    "schemas:check": "npm run generate:check --workspace @neuraforge/schemas",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:property": "vitest run --config vitest.property.config.ts",
    "check": "npm run schemas:check && npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "fast-check": "3.23.2",
    "jsdom": "25.0.1",
    "prettier": "3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "typescript-eslint": "8.19.1",
    "vite": "5.4.21",
    "vitest": "2.1.8"
  }
}
